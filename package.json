{
  "name": "yfv-player",
  "productName": "YFV Player",
  "description": "A cross-platform video player that plays video with a separate audio track and can merge them into one file.",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "marcusdevcode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcusdevcode/YFV-Player.git"
  },
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "dev:frontend": "vite",
    "build": "node scripts/remove-old-builds.mjs && npm run build:mac && npm run docker:all",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "node scripts/run-tauri.mjs",
    "build:app": "node scripts/run-tauri.mjs build",
    "build:mac-arm64": "node scripts/run-tauri.mjs build --target aarch64-apple-darwin",
    "build:mac-x64": "node scripts/run-tauri.mjs build --target x86_64-apple-darwin",
    "build:mac": "npm run build:mac-arm64 && npm run build:mac-x64",
    "docker:linux-x64": "node scripts/docker-build.mjs linux x64",
    "docker:linux-arm64": "node scripts/docker-build.mjs linux arm64",
    "docker:win-x64": "node scripts/docker-build.mjs windows x64",
    "docker:win-arm64": "node scripts/docker-build.mjs windows arm64",
    "docker:linux": "npm run docker:linux-x64 && npm run docker:linux-arm64",
    "docker:win": "npm run docker:win-x64 && npm run docker:win-arm64",
    "docker:all": "npm run docker:linux && npm run docker:win",
    "release": "npm run build && npm run release:publish",
    "release:publish": "node scripts/release-version.js",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "schemas": "node scripts/generate-schemas.mjs",
    "validate:json": "node scripts/validate-json.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
