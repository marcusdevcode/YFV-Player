{
  "name": "yfv-player",
  "productName": "YFV Player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": { "name": "marcusdevcode" },
  "repository": { "type": "git", "url": "https://github.com/marcusdevcode/Vyplyer.git" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "node scripts/tauri.mjs",
    "start": "node scripts/tauri.mjs dev",
    "dev:app": "node scripts/tauri.mjs dev",
    "build:app": "node scripts/tauri.mjs build",
    "build:mac-arm64": "node scripts/tauri.mjs build --target aarch64-apple-darwin",
    "build:mac-x64": "node scripts/tauri.mjs build --target x86_64-apple-darwin",
    "build:mac": "npm run build:mac-arm64 && npm run build:mac-x64",
    "build:win-x64": "node scripts/tauri.mjs build --target x86_64-pc-windows-msvc",
    "build:win-arm64": "node scripts/tauri.mjs build --target aarch64-pc-windows-msvc",
    "build:win": "npm run build:win-x64 && npm run build:win-arm64",
    "build:linux-x64": "node scripts/tauri.mjs build --target x86_64-unknown-linux-gnu",
    "build:linux-arm64": "node scripts/tauri.mjs build --target aarch64-unknown-linux-gnu",
    "build:linux": "npm run build:linux-x64 && npm run build:linux-arm64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
