{
  "name": "yfv-player",
  "productName": "YFV Player",
  "description": "A cross-platform video player that plays video with a separate audio track and can merge them into one file.",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "marcusdevcode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcusdevcode/YFV-Player.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "node scripts/tauri.mjs",
    "start": "node scripts/tauri.mjs dev",
    "dev:app": "node scripts/tauri.mjs dev",
    "build:app": "node scripts/tauri.mjs build",
    "build:mac-arm64": "node scripts/tauri.mjs build --target aarch64-apple-darwin",
    "build:mac-x64": "node scripts/tauri.mjs build --target x86_64-apple-darwin",
    "build:mac": "npm run build:mac-arm64 && npm run build:mac-x64",
    "docker:linux-x64": "node scripts/docker-build.mjs linux x64",
    "docker:linux-arm64": "node scripts/docker-build.mjs linux arm64",
    "docker:win-x64": "node scripts/docker-build.mjs windows x64",
    "docker:win-arm64": "node scripts/docker-build.mjs windows arm64",
    "docker:linux": "npm run docker:linux-x64 && npm run docker:linux-arm64",
    "docker:win": "npm run docker:win-x64 && npm run docker:win-arm64",
    "docker:all": "npm run docker:linux && npm run docker:win",
    "release:collect": "node scripts/release.mjs",
    "release": "npm run release:build && npm run release:publish",
    "release:build": "npm run build:mac && npm run docker:all && npm run release:collect",
    "release:publish": "node scripts/release-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
