{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "re-requiem",
  "name": "RE Requiem",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "requiem",
  "description": "Dark tactical inventory: charcoal grid-lined square cells with notched corners, thin white bars and a red glowing selection.",
  "colors": {
    "background": "#0e0f10",
    "text": "#dedede",
    "textMuted": "#8c9094",
    "border": "#3b3d40",
    "accent": "#c4343a",
    "accentBorder": "#e8575e",
    "accentText": "#ffffff",
    "buttonBackground": "#1c1e20",
    "buttonHover": "#2a2d30",
    "buttonText": "#e4e4e4",
    "panel": "#151617",
    "panelRaised": "#1f2123",
    "badgesBackground": "#101112",
    "badgeText": "#e4e4e4",
    "badgeActiveBorder": "#e8575e",
    "playerBackground": "#050505",
    "controlsBackground": "#131415",
    "controlsText": "#ececec",
    "progressTrack": "#2d2f31",
    "progressBar": "#e6e6e6",
    "progressBarEnd": "#e6e6e6",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#c4343a4d",
    "trackHover": "#ffffff12",
    "rowStripe": "#ffffff05",
    "rowSelected": "#c4343a40",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#000000bf",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6b6b",
    "warningText": "#e0b84a",
    "dangerBackground": "#8a1f25",
    "dangerBorder": "#e8575e"
  },
  "layout": {
    "cornerRadius": 4,
    "panelRadius": 0,
    "shadowSize": 22,
    "windowOpacity": 0.97,
    "panelOpacity": 0.9,
    "panelBlur": 4,
    "panelBorder": 1,
    "panelGlow": 0,
    "progressGlow": 0,
    "progressGloss": 0,
    "textGlow": 0,
    "controlsGap": 16,
    "playlistGap": 16
  }
}
