{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "deus-ex-original",
  "name": "Deus Ex Origins",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "deusex",
  "description": "Gray beveled metal plates with dark inset wells, thin grid cells and white selection outlines, in the style of the 2000 sci-fi role-playing game's menus.",
  "colors": {
    "background": "#111213",
    "text": "#ececec",
    "textMuted": "#9a9da1",
    "border": "#5d6064",
    "accent": "#ffffff",
    "accentBorder": "#ffffff",
    "accentText": "#101112",
    "buttonBackground": "#3b3d40",
    "buttonHover": "#4b4e52",
    "buttonText": "#f2f2f2",
    "panel": "#2c2e31",
    "panelRaised": "#3a3c40",
    "badgesBackground": "#242527",
    "badgeText": "#f2f2f2",
    "badgeActiveBorder": "#ffffff",
    "playerBackground": "#050505",
    "controlsBackground": "#2c2e31",
    "controlsText": "#f2f2f2",
    "progressTrack": "#17181a",
    "progressBar": "#c9ccd1",
    "progressBarEnd": "#f2f4f7",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ffffff26",
    "trackHover": "#ffffff14",
    "rowStripe": "#ffffff07",
    "rowSelected": "#ffffff2e",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#000000b3",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff7b6b",
    "warningText": "#e8c24f",
    "dangerBackground": "#7d2a24",
    "dangerBorder": "#d9574b"
  },
  "layout": {
    "cornerRadius": 10,
    "panelRadius": 10,
    "shadowSize": 20,
    "windowOpacity": 0.86,
    "panelOpacity": 0.7,
    "panelBlur": 0,
    "panelBorder": 2,
    "panelGlow": 0,
    "progressGlow": 0,
    "progressGloss": 0,
    "textGlow": 0,
    "controlsGap": 14,
    "playlistGap": 14
  }
}
