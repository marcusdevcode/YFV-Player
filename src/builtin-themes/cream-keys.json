{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "cream-keys",
  "name": "Cream keys",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Squared keyboard-panel design: black body, cream keys with thin cream lines and a cyan highlight.",
  "colors": {
    "background": "#0f0d0b",
    "text": "#f0dc8c",
    "textMuted": "#a89a62",
    "border": "#8a7d4a",
    "accent": "#f0dc8c",
    "accentBorder": "#fff0b0",
    "accentText": "#16120a",
    "buttonBackground": "#e8d58a",
    "buttonHover": "#f6e6a4",
    "buttonText": "#16120a",
    "panel": "#17140f",
    "panelRaised": "#221e16",
    "badgesBackground": "#120f0b",
    "badgeText": "#f0dc8c",
    "badgeActiveBorder": "#3ec8e8",
    "playerBackground": "#050a10",
    "controlsBackground": "#17140f",
    "controlsText": "#f0dc8c",
    "progressTrack": "#0a0806",
    "progressBar": "#e8d58a",
    "progressBarEnd": "#f6e8a8",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#3ec8e82b",
    "trackHover": "#f0dc8c18",
    "rowStripe": "#f0dc8c0a",
    "rowSelected": "#f0dc8c1f",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#060504cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6a4a",
    "warningText": "#f0b84a",
    "dangerBackground": "#a82a1c",
    "dangerBorder": "#ff6a4a"
  },
  "layout": {
    "cornerRadius": 4,
    "panelRadius": 4,
    "shadowSize": 14,
    "panelBorder": 1,
    "scanlines": 0.06,
    "monospace": true,
    "controlsGap": 16,
    "playlistGap": 16
  }
}
