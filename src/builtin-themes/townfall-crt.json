{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "townfall-crt",
  "name": "Townfall CRT",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Squared retro-terminal design: weathered grey-olive metal, brass edges and an amber glowing CRT screen.",
  "colors": {
    "background": "#2c2b27",
    "text": "#ffb347",
    "textMuted": "#c28a3a",
    "border": "#8a7a46",
    "accent": "#d98a1f",
    "accentBorder": "#f2b24a",
    "accentText": "#1a1006",
    "buttonBackground": "#4a4943",
    "buttonHover": "#5c5a52",
    "buttonText": "#ffb347",
    "panel": "#3b3a35",
    "panelRaised": "#4a4943",
    "badgesBackground": "#33322e",
    "badgeText": "#ffb347",
    "badgeActiveBorder": "#f2b24a",
    "playerBackground": "#140c04",
    "controlsBackground": "#3b3a35",
    "controlsText": "#ffb347",
    "progressTrack": "#1a1008",
    "progressBar": "#c97a12",
    "progressBarEnd": "#ffc766",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ffb34730",
    "trackHover": "#ffb34718",
    "rowStripe": "#ffb3470c",
    "rowSelected": "#ffb34722",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#0c0803cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff7a4a",
    "warningText": "#ffd24a",
    "dangerBackground": "#8a3a14",
    "dangerBorder": "#d9742a"
  },
  "layout": {
    "cornerRadius": 6,
    "panelRadius": 6,
    "shadowSize": 16,
    "panelBorder": 2,
    "panelGlow": 8,
    "progressGlow": 12,
    "progressGloss": 0.3,
    "textGlow": 7,
    "scanlines": 0.22,
    "monospace": true,
    "controlsGap": 18,
    "playlistGap": 18
  }
}
