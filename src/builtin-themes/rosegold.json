  "colors": {
    "background": "#232428",
    "text": "#ece6e2",
    "textMuted": "#a79f9b",
    "border": "#55565c",
    "accent": "#c98f7d",
    "accentBorder": "#e6b4a0",
    "accentText": "#2a1c17",
    "buttonBackground": "#4a4b52",
    "buttonHover": "#5a5b63",
    "buttonText": "#ece6e2",
    "panel": "#3d3e44",
    "panelRaised": "#4a4b52",
    "badgesBackground": "#0d0d0d",
    "badgeText": "#ffffff",
    "badgeActiveBorder": "#ffffff",
    "playerBackground": "#17181b",
    "controlsBackground": "#3d3e44",
    "controlsText": "#ece6e2",
    "progressTrack": "#26272b",
    "progressBar": "#b9786a",
    "progressBarEnd": "#f0c2ae",
    "overlayBackground": "#000000cc",
