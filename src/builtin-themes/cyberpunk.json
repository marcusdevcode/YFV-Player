{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "cyberpunk",
  "name": "Cyberpunk",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Squared neon design: crimson black, cyan panels with glowing edges, scanlines and a terminal font.",
  "colors": {
    "background": "#14070c",
    "text": "#5fe3f0",
    "textMuted": "#3b9aa8",
    "border": "#2f8fa0",
    "accent": "#ff4a42",
    "accentBorder": "#ff7a70",
    "accentText": "#14070c",
    "buttonBackground": "#0f2a33",
    "buttonHover": "#17414f",
    "buttonText": "#5fe3f0",
    "panel": "#0f2a33",
    "panelRaised": "#143743",
    "badgesBackground": "#0b1f27",
    "badgeText": "#5fe3f0",
    "badgeActiveBorder": "#ff4a42",
    "playerBackground": "#0a0306",
    "controlsBackground": "#0f2a33",
    "controlsText": "#5fe3f0",
    "progressTrack": "#2a0d12",
    "progressBar": "#d8322c",
    "progressBarEnd": "#ff6a5e",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ff4a4233",
    "trackHover": "#5fe3f022",
    "rowStripe": "#5fe3f00d",
    "rowSelected": "#5fe3f01f",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#0a0306cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff4a42",
    "warningText": "#ffd24a",
    "dangerBackground": "#b3241f",
    "dangerBorder": "#ff4a42"
  },
  "layout": {
    "cornerRadius": 2,
    "panelRadius": 2,
    "shadowSize": 18,
    "panelOpacity": 0.9,
    "panelBlur": 6,
    "panelBorder": 1,
    "panelGlow": 12,
    "progressGlow": 14,
    "textGlow": 5,
    "scanlines": 0.2,
    "monospace": true,
    "controlsGap": 18,
    "playlistGap": 18
  }
}
