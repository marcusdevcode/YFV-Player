{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "re4",
  "name": "RE4",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "re4",
  "description": "Worn dark-book interface: charcoal smoke, pale serif text, thin dividing lines and a smudged light brush stroke behind the chosen item.",
  "colors": {
    "background": "#0c0c0d",
    "text": "#d8d5cf",
    "textMuted": "#8b8982",
    "border": "#4b4a46",
    "accent": "#cfcbc2",
    "accentBorder": "#f1eee7",
    "accentText": "#101011",
    "buttonBackground": "#1a1a1b",
    "buttonHover": "#2b2b2c",
    "buttonText": "#d8d5cf",
    "panel": "#141415",
    "panelRaised": "#1f1f20",
    "badgesBackground": "#101011",
    "badgeText": "#d8d5cf",
    "badgeActiveBorder": "#f1eee7",
    "playerBackground": "#050505",
    "controlsBackground": "#131314",
    "controlsText": "#e4e1da",
    "progressTrack": "#3a3936",
    "progressBar": "#cfcbc2",
    "progressBarEnd": "#f1eee7",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#cfcbc247",
    "trackHover": "#cfcbc21a",
    "rowStripe": "#ffffff06",
    "rowSelected": "#cfcbc238",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#000000b8",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#e0705a",
    "warningText": "#d9b45a",
    "dangerBackground": "#6e2a22",
    "dangerBorder": "#c4503f"
  },
  "layout": {
    "cornerRadius": 6,
    "panelRadius": 2,
    "shadowSize": 22,
    "windowOpacity": 0.98,
    "panelOpacity": 0.88,
    "panelBlur": 6,
    "panelBorder": 0,
    "panelGlow": 0,
    "progressGlow": 0,
    "progressGloss": 0,
    "textGlow": 0,
    "controlsGap": 16,
    "playlistGap": 16
  }
}
