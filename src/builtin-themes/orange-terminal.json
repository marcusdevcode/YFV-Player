{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "orange-terminal",
  "name": "Orange terminal",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "terminal",
  "description": "Amber terminal: black screen, orange monospace text, a thick orange border around the window, a filled orange title bar and panels cut by thin orange lines.",
  "colors": {
    "background": "#0d0a04",
    "text": "#ffb21e",
    "textMuted": "#b9780f",
    "border": "#ffb21e",
    "accent": "#ffb21e",
    "accentBorder": "#ffc94d",
    "accentText": "#0d0a04",
    "buttonBackground": "#17110a",
    "buttonHover": "#2a1d08",
    "buttonText": "#ffb21e",
    "panel": "#100c05",
    "panelRaised": "#1b1407",
    "badgesBackground": "#0b0803",
    "badgeText": "#ffb21e",
    "badgeActiveBorder": "#ffc94d",
    "playerBackground": "#050301",
    "controlsBackground": "#100c05",
    "controlsText": "#ffb21e",
    "progressTrack": "#3a2a0a",
    "progressBar": "#ffb21e",
    "progressBarEnd": "#ffb21e",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ffb21e",
    "trackHover": "#ffb21e26",
    "rowStripe": "#ffb21e0d",
    "rowSelected": "#ffb21e40",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#000000cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6a4a",
    "warningText": "#ffd24a",
    "dangerBackground": "#8a2a10",
    "dangerBorder": "#ff6a4a"
  },
  "layout": {
    "cornerRadius": 0,
    "panelRadius": 0,
    "shadowSize": 0,
    "windowOpacity": 1,
    "panelOpacity": 1,
    "panelBlur": 0,
    "panelBorder": 2,
    "panelGlow": 8,
    "progressGlow": 8,
    "progressGloss": 0,
    "textGlow": 4,
    "scanlines": 0.18,
    "monospace": true,
    "controlsGap": 14,
    "playlistGap": 14
  }
}
