{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "fallout-2",
  "name": "Fallout 2",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Squared wasteland design: olive metal frames, green phosphor text and a thick border.",
  "colors": {
    "background": "#1b1a14",
    "text": "#3dff4a",
    "textMuted": "#22b52e",
    "border": "#6b6a4f",
    "accent": "#d4c23a",
    "accentBorder": "#ece07a",
    "accentText": "#1b1a14",
    "buttonBackground": "#3a3826",
    "buttonHover": "#4b4832",
    "buttonText": "#d9d27a",
    "panel": "#26241b",
    "panelRaised": "#33301f",
    "badgesBackground": "#211f17",
    "badgeText": "#3dff4a",
    "badgeActiveBorder": "#d4c23a",
    "playerBackground": "#080d08",
    "controlsBackground": "#26241b",
    "controlsText": "#3dff4a",
    "progressTrack": "#0e1a0e",
    "progressBar": "#22c030",
    "progressBarEnd": "#8dff7a",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#3dff4a26",
    "trackHover": "#3dff4a14",
    "rowStripe": "#3dff4a0a",
    "rowSelected": "#3dff4a1c",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#050805cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6a4a",
    "warningText": "#e8d24a",
    "dangerBackground": "#7a2a1a",
    "dangerBorder": "#c2563a"
  },
  "layout": {
    "cornerRadius": 4,
    "panelRadius": 3,
    "shadowSize": 14,
    "panelOpacity": 1,
    "panelBorder": 3,
    "textGlow": 4,
    "scanlines": 0.2,
    "monospace": true,
    "controlsGap": 16,
    "playlistGap": 16
  }
}
