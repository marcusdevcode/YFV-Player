{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "latte",
  "name": "Latte",
  "base": "light",
  "windowStyle": "experimental",
  "description": "Soft cream floating design with terracotta buttons, the light sibling of Espresso.",
  "colors": {
    "background": "#f6e7dc",
    "text": "#3b2a22",
    "textMuted": "#8a6f60",
    "border": "#e3cdbd",
    "accent": "#d98a6c",
    "accentBorder": "#e9a98e",
    "accentText": "#ffffff",
    "buttonBackground": "#fbf4ee",
    "buttonHover": "#f1e2d6",
    "buttonText": "#3b2a22",
    "panel": "#f9ede4",
    "panelRaised": "#f0dccd",
    "badgesBackground": "#f3e2d5",
    "badgeText": "#3b2a22",
    "badgeActiveBorder": "#d98a6c",
    "playerBackground": "#2a1d17",
    "controlsBackground": "#fbf1ea",
    "controlsText": "#3b2a22",
    "progressTrack": "#ecd8ca",
    "progressBar": "#d4806a",
    "progressBarEnd": "#eeb394",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#d98a6c2e",
    "trackHover": "#d98a6c1a",
    "rowStripe": "#d98a6c0d",
    "rowSelected": "#d98a6c24",
    "thumbBackground": "#d8d8d8",
    "dropIndicator": "#e53935",
    "backdrop": "#3b2a2299",
    "shadow": "#00000033",
    "dropHintBackground": "#ffffffcc",
    "errorText": "#b3402a",
    "warningText": "#a8661a",
    "dangerBackground": "#c4523a",
    "dangerBorder": "#e07a60"
  },
  "layout": {
    "cornerRadius": 34,
    "panelRadius": 30,
    "shadowSize": 28,
    "panelOpacity": 0.96,
    "panelBlur": 8,
    "progressGlow": 6,
    "progressGloss": 0.2,
    "controlsGap": 22,
    "playlistGap": 22
  }
}
