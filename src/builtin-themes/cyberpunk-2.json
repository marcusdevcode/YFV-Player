{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "cyberpunk-2",
  "name": "Cyberpunk 2.0",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "cyberpunk2",
  "description": "Neon cyberpunk interface built from the Cyberpunk UI asset pack images: a chamfered glowing window frame, image buttons with hover and pressed states, and an image progress bar.",
  "colors": {
    "background": "#060b12",
    "text": "#c6f8ff",
    "textMuted": "#5fb6c4",
    "border": "#1fc8d6",
    "accent": "#19e6f0",
    "accentBorder": "#7ffbff",
    "accentText": "#031318",
    "buttonBackground": "#101a2b",
    "buttonHover": "#16263d",
    "buttonText": "#c6f8ff",
    "panel": "#0b1420",
    "panelRaised": "#122033",
    "badgesBackground": "#0a121d",
    "badgeText": "#c6f8ff",
    "badgeActiveBorder": "#7ffbff",
    "playerBackground": "#03070c",
    "controlsBackground": "#0b1420",
    "controlsText": "#d9fbff",
    "progressTrack": "#14243a",
    "progressBar": "#19e6f0",
    "progressBarEnd": "#7ffbff",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#19e6f033",
    "trackHover": "#19e6f01a",
    "rowStripe": "#19e6f008",
    "rowSelected": "#19e6f040",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#02060ccc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6f8a",
    "warningText": "#ffd45a",
    "dangerBackground": "#8a1f4a",
    "dangerBorder": "#ff4d8d"
  },
  "layout": {
    "cornerRadius": 0,
    "panelRadius": 0,
    "shadowSize": 0,
    "windowOpacity": 1,
    "panelOpacity": 1,
    "panelBlur": 0,
    "panelBorder": 0,
    "panelGlow": 0,
    "progressGlow": 8,
    "progressGloss": 0,
    "textGlow": 3,
    "controlsGap": 10,
    "playlistGap": 10
  }
}
