{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "green-console",
  "name": "Green console",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Squared control-room design: charcoal metal, grey keys and bright green phosphor screens with a glossy glowing progress bar.",
  "colors": {
    "background": "#1c1d1f",
    "text": "#7dff4a",
    "textMuted": "#4fa82e",
    "border": "#3a3c40",
    "accent": "#7dff4a",
    "accentBorder": "#b4ff8a",
    "accentText": "#0b1a06",
    "buttonBackground": "#3a3b3f",
    "buttonHover": "#4a4b50",
    "buttonText": "#d7d9da",
    "panel": "#2a2b2e",
    "panelRaised": "#35363a",
    "badgesBackground": "#232427",
    "badgeText": "#7dff4a",
    "badgeActiveBorder": "#7dff4a",
    "playerBackground": "#050a04",
    "controlsBackground": "#2a2b2e",
    "controlsText": "#7dff4a",
    "progressTrack": "#0b1408",
    "progressBar": "#3fbf1f",
    "progressBarEnd": "#9dff6a",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#7dff4a2b",
    "trackHover": "#7dff4a16",
    "rowStripe": "#7dff4a0a",
    "rowSelected": "#7dff4a1f",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#050805cc",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff5a3a",
    "warningText": "#ffb02e",
    "dangerBackground": "#b3261e",
    "dangerBorder": "#ff5a3a"
  },
  "layout": {
    "cornerRadius": 10,
    "panelRadius": 8,
    "shadowSize": 20,
    "panelBorder": 2,
    "panelGlow": 6,
    "progressGlow": 12,
    "progressGloss": 0.4,
    "textGlow": 4,
    "scanlines": 0.15,
    "monospace": true,
    "controlsGap": 18,
    "playlistGap": 18
  }
}
