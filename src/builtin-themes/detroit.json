{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "detroit",
  "name": "Detroit",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "detroit",
  "description": "Blue sci-fi interface: dark navy glass panels, thin light borders, corner brackets on the selected item and buttons whose borders have a moving light.",
  "colors": {
    "background": "#0b1a2b",
    "text": "#dcecf7",
    "textMuted": "#6f8ca6",
    "border": "#35597a",
    "accent": "#31c6ff",
    "accentBorder": "#8fe3ff",
    "accentText": "#04141f",
    "buttonBackground": "#14304b",
    "buttonHover": "#1d4262",
    "buttonText": "#cfe6f5",
    "panel": "#0f2740",
    "panelRaised": "#17344f",
    "badgesBackground": "#0c2236",
    "badgeText": "#cfe6f5",
    "badgeActiveBorder": "#8fe3ff",
    "playerBackground": "#07121e",
    "controlsBackground": "#0f2740",
    "controlsText": "#dcecf7",
    "progressTrack": "#1b3a57",
    "progressBar": "#1fa8e6",
    "progressBarEnd": "#8fe3ff",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#31c6ff2e",
    "trackHover": "#31c6ff14",
    "rowStripe": "#ffffff08",
    "rowSelected": "#31c6ff26",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#020a12b3",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff7a7a",
    "warningText": "#ffd36b",
    "dangerBackground": "#a82a3a",
    "dangerBorder": "#ff6b7d"
  },
  "layout": {
    "cornerRadius": 4,
    "panelRadius": 2,
    "shadowSize": 24,
    "windowOpacity": 0.97,
    "panelOpacity": 0.86,
    "panelBlur": 14,
    "panelBorder": 1,
    "panelGlow": 8,
    "progressGlow": 10,
    "progressGloss": 0.35,
    "textGlow": 2,
    "controlsGap": 18,
    "playlistGap": 18
  }
}
