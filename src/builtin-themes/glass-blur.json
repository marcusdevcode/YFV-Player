{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "glass-blur",
  "name": "Glass blur",
  "base": "dark",
  "windowStyle": "experimental",
  "description": "Frosted-glass floating design: a see-through window, and a heavily blurred control bar and playlist cards, with white controls.",
  "colors": {
    "background": "#5c5c60",
    "text": "#ffffff",
    "textMuted": "#d4d4d8",
    "border": "#ffffff4d",
    "accent": "#ffffff",
    "accentBorder": "#ffffff",
    "accentText": "#1c1c1e",
    "buttonBackground": "#ffffff26",
    "buttonHover": "#ffffff40",
    "buttonText": "#ffffff",
    "panel": "#8e8e93",
    "panelRaised": "#ffffff1f",
    "badgesBackground": "#8e8e93",
    "badgeText": "#ffffff",
    "badgeActiveBorder": "#ffffff",
    "playerBackground": "#000000",
    "controlsBackground": "#9a9a9f",
    "controlsText": "#ffffff",
    "progressTrack": "#ffffff59",
    "progressBar": "#ffffff",
    "progressBarEnd": "#ffffff",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ffffff2e",
    "trackHover": "#ffffff1a",
    "rowStripe": "#ffffff0a",
    "rowSelected": "#ffffff29",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#00000066",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff6b6b",
    "warningText": "#e0a030",
    "dangerBackground": "#8b0000",
    "dangerBorder": "#ff0000"
  },
  "layout": {
    "cornerRadius": 52,
    "panelRadius": 40,
    "shadowSize": 30,
    "windowOpacity": 0.55,
    "panelOpacity": 0.42,
    "panelBlur": 40,
    "panelBorder": 1,
    "progressGlow": 4,
    "progressGloss": 0.25,
    "controlsGap": 24,
    "playlistGap": 24
  }
}
