{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "deus-ex-md",
  "name": "Deus Ex MD",
  "base": "dark",
  "windowStyle": "experimental",
  "frame": "deusexmd",
  "description": "Dark faceted glass with black label boxes in white capitals, a white box with black text for the chosen entry, gold titles and thin white lines, in the style of the 2016 sci-fi role-playing sequel's menus.",
  "colors": {
    "background": "#0b0c0e",
    "text": "#e6e6e6",
    "textMuted": "#8a8d92",
    "border": "#3a3c40",
    "accent": "#ffffff",
    "accentBorder": "#ffffff",
    "accentText": "#000000",
    "buttonBackground": "#000000",
    "buttonHover": "#ffffff",
    "buttonText": "#ffffff",
    "panel": "#08090a",
    "panelRaised": "#15161a",
    "badgesBackground": "#050506",
    "badgeText": "#ffffff",
    "badgeActiveBorder": "#ffffff",
    "playerBackground": "#000000",
    "controlsBackground": "#050506",
    "controlsText": "#ffffff",
    "progressTrack": "#2a2c30",
    "progressBar": "#ffffff",
    "progressBarEnd": "#ffffff",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#ffffff",
    "trackHover": "#ffffff1f",
    "rowStripe": "#ffffff08",
    "rowSelected": "#ffffff33",
    "thumbBackground": "#222222",
    "dropIndicator": "#ff0000",
    "backdrop": "#000000b8",
    "shadow": "#0000009a",
    "dropHintBackground": "#00000099",
    "errorText": "#ff7b6b",
    "warningText": "#e8c24f",
    "dangerBackground": "#7d2a24",
    "dangerBorder": "#d9574b"
  },
  "layout": {
    "cornerRadius": 0,
    "panelRadius": 0,
    "shadowSize": 18,
    "windowOpacity": 0.96,
    "panelOpacity": 0.8,
    "panelBlur": 12,
    "panelBorder": 1,
    "panelGlow": 0,
    "progressGlow": 0,
    "progressGloss": 0,
    "textGlow": 0,
    "controlsGap": 14,
    "playlistGap": 14
  }
}
