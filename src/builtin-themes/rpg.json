{
  "$schema": "../../schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "rpg",
  "name": "RPG style",
  "base": "light",
  "windowStyle": "experimental",
  "frame": "rpg",
  "description": "Fantasy-game interface: carved wood frames with gold corner ornaments, parchment panels, gold and brown gradient buttons and capital letters in a serif face.",
  "colors": {
    "background": "#5a3a1c",
    "text": "#3a2410",
    "textMuted": "#7a5a38",
    "border": "#7a4e24",
    "accent": "#d9a553",
    "accentBorder": "#3b2410",
    "accentText": "#3a2410",
    "buttonBackground": "#6e4826",
    "buttonHover": "#86603a",
    "buttonText": "#f5e6c4",
    "panel": "#f1e3bf",
    "panelRaised": "#e6d3a4",
    "badgesBackground": "#e3d0a0",
    "badgeText": "#3a2410",
    "badgeActiveBorder": "#3b2410",
    "playerBackground": "#1b120a",
    "controlsBackground": "#5a3a1c",
    "controlsText": "#f5e6c4",
    "progressTrack": "#7d7a72",
    "progressBar": "#b98a3a",
    "progressBarEnd": "#efc66e",
    "overlayBackground": "#000000cc",
    "overlayText": "#ffffff",
    "trackCurrent": "#d9a5532e",
    "trackHover": "#b4823c26",
    "rowStripe": "#7a4e2410",
    "rowSelected": "#d9a5534d",
    "thumbBackground": "#d8d8d8",
    "dropIndicator": "#e53935",
    "backdrop": "#1b120acc",
    "shadow": "#00000033",
    "dropHintBackground": "#ffffffcc",
    "errorText": "#a82a1a",
    "warningText": "#8a5a10",
    "dangerBackground": "#a8402a",
    "dangerBorder": "#3b2410"
  },
  "layout": {
    "cornerRadius": 24,
    "panelRadius": 16,
    "shadowSize": 28,
    "windowOpacity": 1,
    "panelOpacity": 1,
    "panelBlur": 0,
    "panelBorder": 0,
    "panelGlow": 0,
    "progressGlow": 0,
    "progressGloss": 0.3,
    "controlsGap": 18,
    "playlistGap": 18
  }
}
